# ==========================================
# CONFIGURACIÓN DE SUPABASE (Obligatorio)
# ==========================================
# Obtén estos valores en: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica_aqui

# ==========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==========================================
# Versión actual de la app (se muestra en el panel de admin/backup)
VITE_APP_VERSION=3.5.0

# Tiempo de inactividad para cierre de sesión automático (en milisegundos)
# Ejemplo: 300000 = 5 minutos. Si se omite, usa 300000 por defecto.
VITE_INACTIVITY_TIMEOUT=300000

# ==========================================
# APIs DE TERCEROS (Opcional / Configurables)
# ==========================================
# URL base para la API de tasas de cambio (DolarAPI, etc.)
# Si se omite, usará los endpoints por defecto en el código.
VITE_DOLAR_API_BASE_URL=https://ve.dolarapi.com/v1

# Dirección de correo electrónico remitente para notificaciones
# Nota: La clave de Resend (RESEND_API_KEY) ya NO va en el frontend.
# Se gestiona de forma segura en Supabase Edge Functions (secrets).
VITE_EMAIL_FROM=LANITAPP <notificaciones@tu-dominio.com>

# ==========================================
# ENTORNO
# ==========================================
NODE_ENV=development
